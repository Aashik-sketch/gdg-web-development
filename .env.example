# Copy to .env.local and fill in. Never commit .env.local.
#
# The Firebase *client* SDK is not used by this app -- all Firestore access goes
# through the Admin SDK on the server -- so the NEXT_PUBLIC_FIREBASE_* variables
# that previously appeared here have been removed as unused.

# ==========================================
# 1. LOCAL EMULATOR (optional)
# ==========================================
# Point the Admin SDK at a local emulator instead of Cloud Firestore:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# ==========================================
# 2. FIRESTORE SERVICE ACCOUNT (server only)
# ==========================================
# Required in production. The app now fails to start without credentials
# instead of silently writing to a "demo" project.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
# Paste the service-account key with literal \n escapes, e.g. "-----BEGIN ...\n...\n-----END ...\n"
FIREBASE_PRIVATE_KEY=""

# Alternative to the three variables above:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ==========================================
# 3. BETTER-AUTH
# ==========================================
# REQUIRED. Generate with: openssl rand -base64 32
# Without it, better-auth signs session cookies with a publicly known default.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"  # set to the production origin when deployed

# ==========================================
# 4. GOOGLE OAUTH (optional)
# ==========================================
# Omit both to disable the Google provider entirely.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==========================================
# 5. RECRUITMENT WINDOW
# ==========================================
# ISO-8601 with an explicit UTC offset. Shared by the API deadline check and the
# countdown timer, so the two can no longer drift.
NEXT_PUBLIC_APPLICATION_DEADLINE="2026-12-31T23:59:59+05:30"
NEXT_PUBLIC_MAX_APPLICATIONS_PER_USER="2"

# ==========================================
# 6. OUTBOUND EMAIL (optional)
# ==========================================
# Omit to disable /api/send-email, which then returns 503 instead of failing at
# send time. The endpoint is admin-only.
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
